            <damageAmountBase>50</damageAmountBase>
            <secondaryDamage>
                <li>
                    <def>Bomb_Secondary</def>
                    <amount>15</amount>
                </li>
                <li>
                    <def>Bomb_Secondary</def>
                    <amount>15</amount>
                </li>
            </secondaryDamage>
            <armorPenetrationSharp>15</armorPenetrationSharp>
            <armorPenetrationBlunt>324</armorPenetrationBlunt>
			<pelletCount>2</pelletCount>
        </projectile>
    </ThingDef>

</Defs>