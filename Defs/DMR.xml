<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>GV_ChargeMarksmanRifle</defName>
		<label>charge marksman rifle</label>
		<description>Charged-shot scoped battle rifle, made to combine the role of a sniper with the mobility of a rifleman.\n\nGenerally bulkier, slower to aim, and harder to keep steady than a standard assault rifle, but offers a bigger caliber and longer range. A weapon outclassed by both assault rifles and sniper rifles in their respective niches, but capable of competing with both in highly skilled hands.</description>
		<graphicData>
			<texPath>Things/Weapons/GV_MarksmanRifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<weaponClasses>
			<li>LongShots</li>
			<li>RangedHeavy</li>
		</weaponClasses>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>8.0</Mass>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
			<SightsEfficiency>1.10</SightsEfficiency>
			<ShotSpread>0.03</ShotSpread>
			<SwayFactor>1.80</SwayFactor>
			<Bulk>10.00</Bulk>
			<WorkToMake>49000</WorkToMake>
			<NightVisionEfficiency_Weapon>0.2</NightVisionEfficiency_Weapon>
		</statBases>
		<costList>
			<Steel>50</Steel>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>4</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
			<Chemfuel>15</Chemfuel>
		</costList>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.34</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_8x35mmCharged</defaultProjectile>
				<warmupTime>1.2</warmupTime>
				<range>72</range>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<burstShotCount>2</burstShotCount>
				<soundCast>GV_ChargeBattlerifle_Fire</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>20</magazineSize>
				<reloadTime>4</reloadTime>
				<ammoSet>AmmoSet_8x35mmCharged</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
			</li>
		</comps>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<weaponTags>
			<li>AdvancedGun</li>
			<li>SpacerGun</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>ChargedShot</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>11</Crafting>
			</skillRequirements>
		</recipeMaker>
		<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<chanceFactor>1.5</chanceFactor>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>2.02</cooldownTime>
					<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
		</tools>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<DrawOffset>0.06,0.01</DrawOffset>
			</li>
			<li MayRequire="issaczhuang.muzzleflash" Class="MuzzleFlash.MuzzleFlashProps">
				<def>MF_ChargedMuzzleFalsh</def>
				<drawSize>(1,1)</drawSize>
				<offsets>
					<li>(0.7,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>