<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>GV_ChargeMicrogun</defName>
		<label>charge microgun</label>
		<description>A rotary barrel machine gun that fires pistol-caliber charged-shot rounds. High fire rate and ammo capacity make it excel at prolonged suppressive fire. As an alternative usage practice, the so-called "grinder mode" can be utilized to perform close-range demolition tasks, wear down hard armour, or chew through thick biomass.</description>
		<graphicData>
			<texPath>Things/Weapons/GV_ChargeMicrogun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.0,1.0)</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<weaponClasses>
			<li>RangedLight</li>
			<li>LongShots</li>
		</weaponClasses>
		<generateCommonality>0.7</generateCommonality>
		<statBases>
			<WorkToMake>56000</WorkToMake>
			<SightsEfficiency>1.1</SightsEfficiency>
			<ShotSpread>0.13</ShotSpread>
			<SwayFactor>1.24</SwayFactor>
			<Bulk>5.50</Bulk>
			<Mass>5.25</Mass>
			<RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>50</Steel>
			<Plasteel>45</Plasteel>
			<Chemfuel>10</Chemfuel>
			<ComponentIndustrial>3</ComponentIndustrial>
			<ComponentSpacer>2</ComponentSpacer>
		</costList>
		<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.03</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_6x18mmCharged</defaultProjectile>
				<warmupTime>1.8</warmupTime>
				<range>55</range>
				<burstShotCount>10</burstShotCount>
				<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<aimingLineMote>GV_Mote_LaserPointer_LineAim</aimingLineMote>
				<aimingLineMoteFixedLength>5</aimingLineMoteFixedLength>
				<stopBurstWithoutLos>false</stopBurstWithoutLos>
				<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			</li>
		</verbs>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<weaponTags>
			<li>AdvancedGun</li>
			<li>SpacerGun</li>
			<li>CE_MachineGun</li>
			<li>CE_AI_LMG</li>
			<li>Minigun</li>
		</weaponTags>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<!-- triple of minigun's capacity, as 6x18 has 3x less bulk than 7.62x51 -->
				<magazineSize>750</magazineSize>
				<reloadTime>9.2</reloadTime>
				<ammoSet>AmmoSet_6x18mmCharged</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiUseBurstMode>FALSE</aiUseBurstMode>
				<aiAimMode>SuppressFire</aiAimMode>
				<aimedBurstShotCount>3</aimedBurstShotCount>
			</li>
			<li Class="CombatExtended.CompProperties_UnderBarrel">
				<oneAmmoHolder>true</oneAmmoHolder>
				<underBarrelLabel>to grinder mode</underBarrelLabel>
				<standardLabel>to suppressive mode</standardLabel>
				<propsUnderBarrel>
					<magazineSize>750</magazineSize>
					<reloadTime>9.2</reloadTime>
					<ammoSet>AmmoSet_6x18mmCharged</ammoSet>
				</propsUnderBarrel>
				<verbPropsUnderBarrel>
					<recoilAmount>1.03</recoilAmount>
					<verbClass>CombatExtended.Verb_ShootCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<defaultProjectile>Bullet_6x18mmCharged</defaultProjectile>
					<warmupTime>2.3</warmupTime>
					<range>62</range>
					<burstShotCount>150</burstShotCount>
					<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
					<soundCast>Shot_ChargeBlaster</soundCast>
					<soundCastTail>GunTail_Medium</soundCastTail>
					<muzzleFlashScale>9</muzzleFlashScale>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<aimingLineMote>GV_Mote_LaserPointer_LineAim</aimingLineMote>
					<aimingLineMoteFixedLength>5</aimingLineMoteFixedLength>
					<stopBurstWithoutLos>true</stopBurstWithoutLos>
					<ignorePartialLoSBlocker>false</ignorePartialLoSBlocker>
				</verbPropsUnderBarrel>
				<propsFireModesUnderBarrel>
					<aiUseBurstMode>TRUE</aiUseBurstMode>
					<aiAimMode>AimedShot</aiAimMode>
					<aimedBurstShotCount>25</aimedBurstShotCount>
				</propsFireModesUnderBarrel>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>ChargedShot</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<chanceFactor>1.5</chanceFactor>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2.02</cooldownTime>
				<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<DrawOffset>0.0,-0.15</DrawOffset>
			</li>
			<li MayRequire="issaczhuang.muzzleflash" Class="MuzzleFlash.MuzzleFlashProps">
				<def>MF_ChargedMuzzleFalsh</def>
				<drawSize>(1.0,1.0)</drawSize>
				<offsets>
					<li>(0.48,-0.08)</li>
				</offsets>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>