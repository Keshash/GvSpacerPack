		<statBases>
			<WorkToMake>94500</WorkToMake>
			<SightsEfficiency>1.1</SightsEfficiency>
			<ShotSpread>1.26</ShotSpread>
			<SwayFactor>1.42</SwayFactor>
			<Bulk>20.8</Bulk>
			<Mass>33.0</Mass>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
		</statBases>
