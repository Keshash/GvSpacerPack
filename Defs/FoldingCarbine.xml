		<weaponClasses Inherit="False">
			<li>LongShots</li>
			<li>RangedLight</li>
		</weaponClasses>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Weapons/GV_ExplorerCarbine</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<generateCommonality>0.5</generateCommonality>
		<statBases>
			<WorkToMake>65000</WorkToMake>
			<SightsEfficiency>1.94</SightsEfficiency>
			<ShotSpread>0.09</ShotSpread>
			<SwayFactor>1.43</SwayFactor>
			<Bulk>4.00</Bulk>
			<Mass>3.50</Mass>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
			 <!-- double cooldown because of 1 handed operation -->
			<!-- <RangedWeapon_Cooldown>0.72</RangedWeapon_Cooldown> -->
			<NightVisionEfficiency_Weapon>0.2</NightVisionEfficiency_Weapon>
		</statBases>
