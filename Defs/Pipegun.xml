<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>GV_ChargePipeGun</defName>
		<label>charge pipe gun</label>
		<description>A single-shot charge rifle variant, designed to cut costs as much as possible while maintaining reasonable bullet performance.\n\nFeatures an adapter to switch between different calibers, allowing the shooter to load most of the popular large-caliber charge rounds.\n\nDue to the lack of several regulatory safety components, it is not capable of automatic fire and is very prone to breaking in melee combat or when dropped carelessly.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Weapons/GV_Pipegun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<weaponClasses>
			<li>LongShots</li>
			<li>RangedHeavy</li>
		</weaponClasses>
		<statBases>
			<MaxHitPoints>15</MaxHitPoints>
			<WorkToMake>50500</WorkToMake>
			<SightsEfficiency>1.0</SightsEfficiency>
			<ShotSpread>0.03</ShotSpread>
			<SwayFactor>1.47</SwayFactor>
			<Bulk>14.0</Bulk>
			<Mass>7.0</Mass>
			<RangedWeapon_Cooldown>0.57</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>70</Steel>
			<Plasteel>15</Plasteel>
			<ComponentIndustrial>1</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.82</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_8x50mmCharged</defaultProjectile>
				<warmupTime>1.2</warmupTime>
				<range>55</range>
				<soundCast>GV_ChargeBattlerifle_Fire</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>25</muzzleFlashScale>
				<aimingChargeMote>GV_Mote_SmokeRising</aimingChargeMote>
				<aimingChargeMoteOffset>1.25</aimingChargeMoteOffset>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>1</reloadTime>
				<ammoSet>GV_AmmoSet_Charged_PipeGun</ammoSet>
				<AmmoGenPerMagOverride>8</AmmoGenPerMagOverride>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiAimMode>AimedShot</aiAimMode>
			</li>
		</comps>
		<weaponTags Inherit="False">
			<li>AdvancedGun</li>
			<li>SpacerGun</li>
			<li>CE_AI_SR</li>
		</weaponTags>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<recipeMaker>
			<researchPrerequisite>Fabrication</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>TableMachining</li>
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<chanceFactor>1.5</chanceFactor>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2.02</cooldownTime>
				<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.55</cooldownTime>
				<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
		<modExtensions>
			<li Class="CombatExtended.GunDrawExtension">
				<DrawOffset>0.25,-0.15</DrawOffset>
				<DrawSize>1.6,1.6</DrawSize>
			</li>
			<li MayRequire="issaczhuang.muzzleflash" Class="MuzzleFlash.MuzzleFlashProps">
				<def>MF_ChargedMuzzleFalsh</def>
				<drawSize>(3.5,1.5)</drawSize>
				<offsets>
					<li>(0.96,-0.16)</li>
				</offsets>
			</li>
		</modExtensions>
	</ThingDef>


</Defs>