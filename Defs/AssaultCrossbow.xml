	<ThingDef ParentName="BaseWeaponNeolithic">
		<defName>GV_ChargeCrossbow</defName>
		<label>charge crossbow</label>
		<description>A spacer-age reiteration of the medieval crossbow design. Launches plasteel bolts at high velocity, charging them with unstable energy in the process. Magazine-fed and semi-automatic.\n\nWhile only the bolts of pure plasteel are receptive to being charged, it can also launch specialised bolts. Typically, the bolts launched explode into splinters upon impact, making it impossible to reuse ammunition.\n\nPopular among big-game hunters.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Weapons/GV_AssaultCrossbow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_ChargeRifle</soundInteract>
		<weaponClasses Inherit="False">
			<li>LongShots</li>
			<li>RangedLight</li>
		</weaponClasses>
		<generateCommonality>0.2</generateCommonality>
		<statBases>
			<WorkToMake>38000</WorkToMake>
			<Mass>3.5</Mass>
			<Bulk>9</Bulk>
			<SwayFactor>1.25</SwayFactor>
			<ShotSpread>0.4</ShotSpread>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
			<SightsEfficiency>1.10</SightsEfficiency>
		</statBases>
		<costList>
			<Steel>50</Steel>
			<Plasteel>25</Plasteel>
			<Chemfuel>10</Chemfuel>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>GV_Projectile_CrossbowBolt_Plasteel</defaultProjectile>
				<warmupTime>1.0</warmupTime>
				<range>36</range>
				<soundCast>Shot_CE_Crossbow</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
			</li>
		</verbs>
		<thingSetMakerTags>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
		<weaponTags Inherit="False">
			<li>SniperRifle</li>
			<li>AdvancedGun</li>
			<li>SpacerGun</li>
			<li>CE_AI_SR</li>
		</weaponTags>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>16</magazineSize>
				<AmmoGenPerMagOverride>3</AmmoGenPerMagOverride>
				<reloadTime>4</reloadTime>
				<ammoSet>AmmoSet_CrossbowBolt_Charged</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aiAimMode>AimedShot</aiAimMode>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>ChargedShot</researchPrerequisite>
			<recipeUsers Inherit="false">
				<li>FabricationBench</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>9</Crafting>
			</skillRequirements>
		</recipeMaker>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>1.6</cooldownTime>
				<armorPenetrationBlunt>0.65</armorPenetrationBlunt>
			</li>
		</tools>
	</ThingDef>


</Defs>